# Mirepoix on Apache (R1.12, D11). Upload it with the rest of app/; most FTP
# clients hide files starting with a dot, so turn on "show hidden files".

# Security headers (D7): the same as the dev server's (tools/serve.js). A unit
# test keeps the two equal. No HSTS here: it would apply to the whole domain.
<IfModule mod_headers.c>
  # Google's domains are there for the opt-in Google Analytics (D14).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://api.github.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"

  # The service worker keeps the app for offline use; the browser should
  # still ask the server every time whether a file changed, so new versions arrive.
  Header set Cache-Control "no-cache"
</IfModule>

# HTTPS only: service workers and Web Crypto need it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Types some hosts don't know yet.
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType text/javascript .js

Options -Indexes
